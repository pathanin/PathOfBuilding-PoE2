-- Template for headless PoB2 DPS comparisons.
-- Copy this into src/_scratch_<name>.lua (src/_scratch_* is gitignored, see .git/info/exclude),
-- fill in the placeholders, run it from src/, then delete it when done.
--
-- Run from repo src/ dir:
--   LUA_PATH="../runtime/lua/?.lua;../runtime/lua/?/init.lua;;" \
--   LUA_CPATH="../runtime/?.so;;" \
--   luajit _scratch_<name>.lua

dofile("HeadlessWrapper.lua")

local f = io.open("BUILD_XML_PATH_HERE", "r")
local xmlText = f:read("*a")
f:close()

loadBuildFromXML(xmlText, "headless-analysis")

-- Uncomment to dump every socket group and its gems, to find the group index
-- you want (build.mainSocketGroup from the export is just the *default* main
-- skill in PoB's UI -- any group can be selected for calc purposes):
--
-- for i, grp in ipairs(build.skillsTab.socketGroupList) do
-- 	local names = {}
-- 	for _, g in ipairs(grp.gemList or {}) do table.insert(names, g.nameSpec or "?") end
-- 	print(i, grp.source or "(no source)", table.concat(names, " | "))
-- end

local GROUP_INDEX = 1 -- <-- set to the socket group you want to evaluate

local function recalc(label)
	build.mainSocketGroup = GROUP_INDEX
	build.buildFlag = true
	build.modFlag = true
	runCallback("OnFrame")
	build.calcsTab:BuildOutput()
	runCallback("OnFrame")
	local out = build.calcsTab.mainOutput
	print(string.format(
		"[%s] TotalDPS=%.2f CombinedDPS=%.2f CritChance=%s AverageDamage=%.2f",
		label, out.TotalDPS or -1, out.CombinedDPS or -1, tostring(out.CritChance), out.AverageDamage or -1))
end

recalc("baseline")

